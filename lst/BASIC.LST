    84                              <1> ;Special qword:
    85                              <1> ; Byte 7 = Offset into the line for the condition to evaluate
    86                              <1> ; Bytes[6:5] = Line number of WHILE 
    87                              <1> ; Byte 4 = Offset in line for either first : after WEND or ASCII NULL (end of line)
    88                              <1> ; Bytes[3:2] = Line number of WEND
    89                              <1> ; Byte 1 = Parity check sum for the qword, makes the sum of the bytes in qword 0
    90                              <1> ; Byte 0 = WHILE signature
    91                              <1> endstruc
    92                              <1> 
    93                              <1> struc gosubStruct
    94 00000000 ????????????????    <1>     .specQword  dq ?  ;Special qword
    95                              <1> ;Special qword:
    96                              <1> ; Byte 7 =  Offset in line for either first : after GOSUB or ASCII NULL (end of line)
    97                              <1> ; Bytes[6:5] = Line number of GOSUB 
    98                              <1> ; Bytes[4:2] = 055AA55h space filler signature
    99                              <1> ; Byte 1 = Parity check sum for the qword, makes the sum of the bytes in qword 0
   100                              <1> ; Byte 0 = GOSUB signature
   101                              <1> endstruc
