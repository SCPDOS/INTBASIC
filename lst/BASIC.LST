   482 000007F1 5B                  <1>     pop rbx
   483 000007F2 59                  <1>     pop rcx
   484 000007F3 5E                  <1>     pop rsi
   485 000007F4 C3                  <1>     ret
   486                              <1> .makeEditInteger:
