   464                              <1> 
   465                              <1> setNumericVariable:
   466                              <1> ;Sets the value stored in a variable
   467                              <1> ;Input: rsi = Pointer to first char of a variable name
   468                              <1> ;       rax = Variable value
   469                              <1> ;Output: rsi = Pointer to first char of variable name
   470 000007D1 56                  <1>     push rsi
   471 000007D2 51                  <1>     push rcx
   472 000007D3 53                  <1>     push rbx
   473                              <1> 
   474 000007D4 E8E4FBFFFF          <1>     call getVarNameLength   ;Returns the length of the var name in cx
   475 000007D9 E8D90B0000          <1>     call findVariable       ;Returns a pointer to the variable block in rbx
   476 000007DE 4881FBFFFFFFFF      <1>     cmp rbx, -1             ;Variable doesnt exit?
   477 000007E5 740E                <1>     je .makeEditInteger      ;Make one!
   478 000007E7 807B0301            <1>     cmp byte [rbx + memBlock.bBlockType], varBlockType
   479 000007EB 750F                <1>     jne .stringFoundError
   480 000007ED 48894304            <1>     mov qword [rbx + varBlock.qValue], rax  ;Save value
