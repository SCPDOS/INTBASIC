    69 00000000 ????????????????    <1>     .specQword  dq ?  ;Special qword (see function description)
    70 00000008 ????????????????    <1>     .cntrPtr    dq ?  ;Pointer to counter variable
    71 00000010 ????????????????    <1>     .limitValue dq ?  ;At what value, or after, do we stop the loop 
    72 00000018 ????????????????    <1>     .stepValue  dq ?  ;By how much do we increase on each iteration
    73                              <1> ;Special qword:
    74                              <1> ; Byte 7 = Offset into the line for next instruction after FOR
    75                              <1> ; Bytes[6:5] = Line number of portion after FOR (either FOR line or line after FOR)
    76                              <1> ; Byte 4 = Offset into the line for next instruction after NEXT
    77                              <1> ; Bytes[3:2] = Line number of portion after NEXT (either NEXT line or line after NEXT)
    78                              <1> ; Byte 1 = Parity check sum for the qword, makes the sum of the bytes in qword 0
    79                              <1> ; Byte 0 = FOR signature
    80                              <1> endstruc
    81                              <1> 
