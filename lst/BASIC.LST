    19                              <1> ;==============================================================================
    20                              <1> 
    21                              <1> ;void* mcbChain, lastBlock, firstLinPtr = -1 => New program, empty entries
    22                              <1> 
    23 00000ED8 ??                  <1> strLen      resb 1  ;Counter for number of chars entered in string
    24 00000ED9 ??                  <1> stateByte   resb 1  ;Bit 0 => Break Set, stop processing after end of current line
    25 00000EDA ????????????????    <1> mcbChain    resq 1  ;Pointer to the start of the chain
    26 00000EE2 ????????????????    <1> lastBlock   resq 1  ;Pointer to the last block
    27 00000EEA ????????????????    <1> firstLinPtr resq 1  ;Pointer to the programs' first line 
    28 00000EF2 ????                <1> firstLinNum resw 1  ;Line number of the first line of the program
    29 00000EF4 ????                <1> currentLine resw 1  ;Currently being executed line number
    17                                  Segment programArea align=1 vfollows=dSeg valign=16 ;Para aligned
